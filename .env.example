# 복사해서 루트에 .env 로 저장 후 값 입력 (.env 는 gitignore — 절대 커밋 금지).
# 백엔드·DB 컨테이너만 읽는다. 차량/모바일 앱에는 어떤 키도 넣지 않는다.
POSTGRES_DB=roadfm
POSTGRES_USER=roadfm
POSTGRES_PASSWORD=

# 한국관광공사 TourAPI (data.go.kr 서비스키)
TOURAPI_SERVICE_KEY=
# 카카오모빌리티 길찾기 REST API 키
KAKAO_MOBILITY_REST_KEY=
# LLM / TTS (서버에서만 호출)
LLM_API_KEY=
TTS_API_KEY=
